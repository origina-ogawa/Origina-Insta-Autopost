{
  "canvas": {
    "width": 1080,
    "height": 1350,
    "aspect": "4:5",
    "note": "src/render.jsのPlaywright viewportと一致させること(実際のレンダリングサイズはここではなくrender.js側で決まる)。Instagramのフィードで許される最も縦長の比率"
  },
  "safeArea": {
    "top": 80,
    "bottom": 80,
    "left": 80,
    "right": 80,
    "note": "下部はUI要素に隠れる可能性があるため余白を確保する。左右は、プロフィールの一覧(3:4表示)で4:5画像の左右が約34pxずつ切られる分も見込んでいる"
  },
  "font": {
    "_lock": "この値は変更禁止。収まらない場合は文章を短くすること",
    "heading": {
      "size": 104,
      "lineHeight": 1.28,
      "weight": 900,
      "maxChars": 20,
      "maxLines": 2
    },
    "body": {
      "size": 62,
      "lineHeight": 1.45,
      "weight": 700,
      "maxChars": 60,
      "maxLines": 4
    },
    "caption": {
      "size": 36,
      "lineHeight": 1.5,
      "weight": 700,
      "maxChars": 30,
      "maxLines": 1
    }
  },
  "limits": {
    "slideTotalChars": 80,
    "slideCountMin": 8,
    "slideCountMax": 10
  },
  "color": {
    "bg": "#0F1115",
    "text": "#FFFFFF",
    "textMuted": "#9AA0A6",
    "accent": "#4F8DF7"
  }
}
